# ==============================================================================
# LangChain Context-Aware AI Assistant - Environment Configuration
# ==============================================================================

# LLM Provider Selection: "google" or "openai"
LLM_PROVIDER=google

# Google Gemini API Key & Model Configuration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_DEFAULT_MODEL=gemini-3.5-flash-lite

# OpenAI API Key & Model Configuration (Optional alternative)
OPENAI_API_KEY=your_openai_api_key_here
OPENAI_DEFAULT_MODEL=gpt-4o-mini

# Context Window Configuration (Sliding Window)
# Number of most recent conversation turns (User query + AI response) to keep in memory
CONTEXT_WINDOW_TURNS=5
